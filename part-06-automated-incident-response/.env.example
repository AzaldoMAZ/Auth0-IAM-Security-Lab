# Reuses the same M2M application from Part 5, but that application
# must ALSO be authorized for these two additional Management API scopes:
#   read:users
#   update:users
AUTH0_DOMAIN=
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=

# Optional: a Slack incoming-webhook URL (or any endpoint that accepts
# {"text": "..."} as JSON). Leave blank to skip webhook alerts.
WEBHOOK_URL=

# Safety switch. true = simulate every action, block nothing for real.
# Set to false only when you're ready to see a real account get blocked.
DRY_RUN=true